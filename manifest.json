{
  "id": "family-polls",
  "name": "Polls",
  "version": "1.0.0",
  "description": "Adults create simple family polls with fixed choices; each member may cast one final vote. Votes stay hidden until an adult closes the poll. Attributed polls then show who voted for what; anonymous polls record no voter at all.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["polls", "voting", "decisions", "everyone"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "storage": "db",
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_family_polls__polls WHERE status = 'open' LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "polls open",
      "severity": "info"
    }
  },
  "row_policies": {
    "polls": {
      "kind": "adult_writable",
      "steward_writes_only": true,
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["closed"]
      },
      "retain_days": {
        "default": 730,
        "timestamp_column": "created_at",
        "dependent_tables": [
          { "table": "poll_votes", "foreign_key": "poll_id" },
          { "table": "votes", "foreign_key": "poll_id" },
          { "table": "vote_receipts", "foreign_key": "poll_id" }
        ]
      }
    },
    "poll_votes": {
      "kind": "sealed_until",
      "fk_column": "poll_id",
      "parent_table": "polls",
      "writer_column": "member_id",
      "parent_status_column": "status",
      "visible_parent_status_values": ["closed"],
      "endpoint_writes_only": true
    },
    "votes": {
      "kind": "sealed_until",
      "fk_column": "poll_id",
      "parent_table": "polls",
      "writer_column": "member_id",
      "parent_status_column": "status",
      "visible_parent_status_values": ["closed"],
      "endpoint_writes_only": true
    },
    "vote_receipts": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false,
      "member_can_update": false,
      "endpoint_writes_only": true
    }
  },
  "anonymous_responses": {
    "receipt_table": "vote_receipts",
    "session_column": "poll_id",
    "member_column": "member_id",
    "created_at_column": "created_at",
    "response_table": "poll_votes",
    "response_session_column": "poll_id",
    "response_member_column": "member_id",
    "response_answer_column": "option_id",
    "response_id_column": "id",
    "response_created_at_column": "created_at",
    "session_table": "polls",
    "session_id_column": "id",
    "session_status_column": "status",
    "session_open_value": "open",
    "session_anonymous_column": "anonymous",
    "result_visible_values": ["closed"]
  },
  "member_references": {
    "polls": { "column": "created_by", "on_removed": "keep" },
    "poll_votes": { "column": "member_id", "on_removed": "null" },
    "votes": { "column": "member_id", "on_removed": "delete" },
    "vote_receipts": { "column": "member_id", "on_removed": "delete", "id_column": "rowid" }
  },
  "publishes": ["poll.created"],
  "publish_acls": {
    "poll.created": { "require_role": "adult" }
  },
  "alert_on": ["poll.created"],
  "nav": { "label": "Polls" },
  "widget": {
    "label": "Polls",
    "size": "small"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🗳️"
}
